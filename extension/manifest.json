{
  "manifest_version": 3,
  "name": "Nudge — Email Tracker",
  "version": "1.4.0",
  "description": "Get alerted the moment someone opens your email — no reply needed. Works on Gmail, Outlook, Proton Mail, Tuta, Infomaniak, and Yahoo Mail. Compatible with Chrome and Edge.",

  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "scripting",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],

  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*"],

  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://mail.proton.me/*",
    "https://mail.protonmail.com/*",
    "https://app.tuta.com/*",
    "https://mail.tutanota.com/*",
    "https://mail.infomaniak.com/*",
    "https://mail.yahoo.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.yusercontent.com/*",
    "http://localhost:8080/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://mail.proton.me/*",
        "https://mail.protonmail.com/*",
        "https://app.tuta.com/*",
        "https://mail.tutanota.com/*",
        "https://mail.infomaniak.com/*",
        "https://mail.yahoo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail-ticks.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Nudge Email Tracker",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
